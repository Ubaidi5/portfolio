# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://ubaidhussain.me

# Contact form (Zoho SMTP, same as the old site)
EMAIL_USER=
EMAIL_PASSWORD=
CONTACT_EMAIL=

# Newsletter subscriptions (https://buttondown.com -> Settings -> API)
BUTTONDOWN_API_KEY=

# Admin (/admin)
ADMIN_PASSWORD=
# Any random string of 32+ characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Stories database (MongoDB Atlas connection string) and optional database name
MONGODB_URI=
MONGODB_DB=website

# Cover image uploads (Vercel dashboard -> Storage -> Blob, connect to this project)
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 measurement ID (analytics.google.com -> Admin -> Data streams), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Optional: Search Console "HTML tag" verification code (only the content value).
# Not needed if you verify the domain with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=
